# Optional. Copy to app/.env only if you need to change these. The app runs without this file.
# Every EXPO_PUBLIC_* value ships to every user, so never put a secret here.

# Where the API is. Defaults: http://localhost:8080 on web, http://10.0.2.2:8080 on the Android emulator.
# On a physical Android phone, use your computer's LAN address. Restart Expo after changing this.
# EXPO_PUBLIC_API_URL=https://your-api.onrender.com

# The base map style. Defaults to OpenFreeMap, which needs no API key.
# EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
