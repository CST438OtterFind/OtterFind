# Everyone keeps their own copy: `cp .env.example .env`, then fill in what your machine needs. Git ignores .env.
# Production values go in Render's dashboard, not here.

# Local values for `docker compose up`. Leave these as they are.
# Running the API from Android Studio instead? Its run configuration doesn't read this file. Paste the lines it
# needs into Environment variables, separated by `;`, and start only the database with `docker compose up db`.
DATABASE_URL=jdbc:postgresql://localhost:5432/otterfind
DATABASE_USER=otterfind
DATABASE_PASSWORD=otterfind

# Supabase, for teammates who are admins on the project. Optional: only a database client such as psql or DBeaver
# uses these, to look at the real data. The dashboard's Table Editor and SQL Editor need none of them.
# The API never reads these names, so a local run can't reach the real database by accident. Don't copy them into
# DATABASE_* above: Flyway would apply your branch's migrations to the real database as soon as the API started.
# The user is postgres.<project-ref>, from Supabase > Connect > Session pooler. psql takes the URL without `jdbc:`.
# Supabase can't show the password again, only reset it, and a reset disconnects the deployed API until Render's
# DATABASE_PASSWORD is changed to match. Ask the project owner for it instead of resetting it.
SUPABASE_DATABASE_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DATABASE_USER=postgres.<project-ref>
SUPABASE_DATABASE_PASSWORD=

# The API's own access tokens. REQUIRED: the API will not start without it.
# Make your own with `openssl rand -base64 32`. It doesn't need to match anyone else's, and Render has its own.
APP_JWT_SECRET_BASE64=
APP_JWT_ISSUER=http://localhost:8080
# Not read by the API yet.
APP_JWT_TTL=PT1H

# Browser origins allowed to call the API (comma-separated): Expo web dev server and the deployed web build,
# e.g. http://localhost:8081,https://otterfind.onrender.com
APP_CORS_ORIGINS=http://localhost:8081

# Sign-in (Sprint 1-2, Appendix I). Client IDs are public; client secrets stay server-side.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# Image storage. Not read by the API yet.
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional settings for the Expo app. Every EXPO_PUBLIC_* value ships to every user, so never put a secret in one.
# Expo reads this same .env file, or a .env.local if you'd rather keep them apart. Restart Expo after a change.

# Where the API is. Defaults: http://localhost:8080 on web, http://10.0.2.2:8080 on the Android emulator.
# On a physical Android phone, use your computer's LAN address. To try the deployed API, use the line below. From
# Expo web, that also needs http://localhost:8081 in Render's APP_CORS_ORIGINS. The test account only exists locally.
# EXPO_PUBLIC_API_URL=https://otterfind.onrender.com

# The base map style. Defaults to OpenFreeMap, which needs no API key.
# EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Shows a "Use test account" button. Only works against compose.e2e.yml. See README.md.
# EXPO_PUBLIC_TEST_ACCOUNT=true
