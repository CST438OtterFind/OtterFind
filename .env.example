# Local values for `docker compose up`. Production values go in Render's dashboard, not here.
DATABASE_URL=jdbc:postgresql://localhost:5432/otterfind
DATABASE_USER=otterfind
DATABASE_PASSWORD=otterfind

# The API's own access tokens. REQUIRED: the API will not start without it.
# Generate one with: openssl rand -base64 32
APP_JWT_SECRET_BASE64=
APP_JWT_ISSUER=http://localhost:8080
APP_JWT_TTL=PT1H

# Browser origins allowed to call the API (comma-separated): Expo web dev server and the deployed web build,
# e.g. http://localhost:8081,https://otterfind.onrender.com
APP_CORS_ORIGINS=http://localhost:8081

# Sign-in (Sprint 1-2, Appendix I). Client IDs are public; client secrets stay server-side.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# Image storage. Not read by the API yet.
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional settings for the Expo app. Every EXPO_PUBLIC_* value ships to every user, so never put a secret in one.
# Expo reads this same .env file, or a .env.local if you'd rather keep them apart. Restart Expo after a change.

# Where the API is. Defaults: http://localhost:8080 on web, http://10.0.2.2:8080 on the Android emulator.
# On a physical Android phone, use your computer's LAN address. To try the deployed API, use the line below. From
# Expo web, that also needs http://localhost:8081 in Render's APP_CORS_ORIGINS.
# EXPO_PUBLIC_API_URL=https://otterfind.onrender.com

# The base map style. Defaults to OpenFreeMap, which needs no API key.
# EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
