DATABASE_URL=jdbc:postgresql://localhost:5432/otterfind
DATABASE_USER=otterfind
DATABASE_PASSWORD=otterfind

# The API's own access tokens. REQUIRED: the API will not start without it.
# Generate one with: openssl rand -base64 32
APP_JWT_SECRET_BASE64=
APP_JWT_ISSUER=http://localhost:8080
APP_JWT_TTL=PT1H

# Browser origins allowed to call the API (comma-separated): Expo web dev server and the deployed web build,
# e.g. http://localhost:8081,https://otterfind.onrender.com
APP_CORS_ORIGINS=http://localhost:8081

# Sign-in (Sprint 1-2, Appendix I). Client IDs are public; client secrets stay server-side.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=