{
  "name": "otterfind",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node app/scripts/copy-maplibre-worker.js",
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web --port 8081",
    "build:web": "expo export --platform web",
    "typecheck": "npm run typecheck --workspace app",
    "test": "npm test --workspace app",
    "test:coverage": "npm run test:coverage --workspace app",
    "e2e": "npm run e2e --workspace app"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@maplibre/maplibre-react-native": "^11.5.1",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "maplibre-gl": "^6.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "workspaces": [
    "app"
  ]
}
